{
  "manifest_version": 3,
  "name": "稿迹 · 投稿状态同步",
  "version": "0.4.0",
  "description": "从 Elsevier、Taylor & Francis、Springer Nature 投稿系统读取当前稿件状态并同步到稿迹。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.editorialmanager.com/*",
    "https://editorialmanager.com/*",
    "https://submit.elsevier.com/*",
    "https://rp.tandfonline.com/*",
    "https://mc.manuscriptcentral.com/*",
    "https://link.springernature.com/*",
    "https://my-profile.springernature.com/*",
    "https://submission.nature.com/*",
    "https://*.nature.com/*",
    "https://gaoji-journal-track.de5.net/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "稿迹 · 投稿状态同步",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.editorialmanager.com/*",
        "https://editorialmanager.com/*",
        "https://submit.elsevier.com/*",
        "https://rp.tandfonline.com/*",
        "https://mc.manuscriptcentral.com/*",
        "https://link.springernature.com/*",
        "https://my-profile.springernature.com/*",
        "https://submission.nature.com/*",
        "https://*.nature.com/*"
      ],
      "js": ["submission-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gaoji-journal-track.de5.net/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
